        "除法",
        "分数",
        "小数",
        "方程",
        "几何证明",
        "面积和周长"
      ],
      "semesters": {
        "上册": [
          "数一数（1~10的认识）",
          "比一比（多少、长短、高矮）",
          "1~5的认识和加减法",
          "认识图形（长方体、正方体、圆柱、球）",
          "6~10的认识和加减法",
          "11~20各数的认识（数位、十加几）",
          "认识钟表（整时、半时）",
          "20以内的进位加法（凑十法：9加几、8加几）"
        ],
        "下册": [
          "认识图形（长方形、正方形、三角形、圆、平行四边形）",
          "20以内的退位减法（破十法、平十法：十几减9、十几减8）",
          "分类与整理",
          "100以内数的认识（数位、组成、比大小）",
          "认识人民币（1元=10角、1角=10分、换钱、购物）",
          "100以内的加法和减法（一）（整十数加减、两位数加减一位数和整十数）",
          "找规律"
        ]
      }
    },
    "英语": {
      "allowed": [
        "26个英文字母识读",
        "简单日常问候用语",
        "常见动物、水果、颜色单词",
        "数数1-10英文"
      ],
      "forbidden": [
        "语法概念",
        "句型结构",
        "阅读理解",
        "拼写规则"
      ]
    }
  },
  "小学二年级": {
    "语文": {
      "allowed": [
        "拼音巩固",
        "常用汉字（500字以内）",
        "简单句子仿写",
        "看图写话",
        "古诗背诵（五言）",
        "查字典",
        "标点符号（逗号、句号、问号、感叹号）"
      ],
      "forbidden": [
        "段落写作超过3句话",
        "修辞手法系统讲解",
        "文言文",
        "说明文阅读",
        "议论文"
      ]
    },
    "数学": {
      "allowed": [
        "100以内加减法",
        "表内乘法（九九口诀）",
        "长度单位（厘米、米）",
        "认识角",
        "认识时间（几时几分）",
        "简单的排列组合（搭配问题）",
        "数据收集与整理"
      ],
      "forbidden": [
        "多位数乘除法",
        "分数运算",
        "小数运算",
        "面积计算",
        "方程",
        "周长计算"
      ],
      "semesters": {
        "上册": [
          "长度单位（厘米和米，1米=100厘米，测量与画线段）",
          "100以内的加法和减法（笔算竖式：进位加、退位减）",
          "角的初步认识（锐角、直角、钝角，角有1个顶点2条边）",
          "表内乘法（一）（乘法的意义，2~6的乘法口诀，乘加乘减）",
          "观察物体（一）（从正面、侧面、上面观察）",
          "表内乘法（二）（7、8、9的乘法口诀）",
          "认识时间（1时=60分，几时几分，一刻钟、半小时）",
          "数学广角——搭配（一）（简单排列组合）"
        ],
        "下册": [
          "数据收集整理（简单统计表）",
          "表内除法（一）（平均分，用2~6的乘法口诀求商）",
          "图形的运动（一）（轴对称、平移、旋转）",
          "表内除法（二）（用7、8、9的口诀求商，倍的认识）",
          "混合运算（先乘除后加减，有括号先算括号）",
          "有余数的除法（余数一定比除数小，进一法去尾法解决问题）",
          "万以内数的认识（数位、读数写数、比大小、近似数、整百整千加减法）",
          "克和千克（1千克=1000克，认识秤，估量重量）",
          "数学广角——推理（简单逻辑推理）"
        ]
      }
    },
    "英语": {
      "allowed": [
        "字母书写",
        "简单日常用语",
        "常见物品单词",
        "家庭成员称呼英文",
        "简单的数字1-20英文"
      ],
      "forbidden": [
        "时态",
        "句型",
        "朗读技巧",
        "拼写规则"
      ]
    }
  },
