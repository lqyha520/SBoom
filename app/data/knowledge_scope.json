      "allowed": [
        "拼音认读",
        "简单汉字书写（200字以内）",
        "看图说话",
        "简单儿歌背诵",
        "基本笔画和笔顺",
        "简单词语搭配",
        "反义词"
      ],
      "forbidden": [
        "成语故事",
        "段落写作",
        "阅读理解超过50字",
