{
  "name": "learn-coach-admin",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "node scripts/normalize-types.mjs && vue-tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "preview": "vite preview",
    "xhs:collector:install": "playwright install chromium",
    "xhs:collector": "node scripts/xhs-local-collector.mjs",
    "xhs:collector:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/install-local-startup.ps1",
    "test": "vitest run",
    "test:xhs-assist": "node --test scripts/xhs-publish-assist.browser.test.mjs",
    "test:xhs-accounts": "node --test scripts/xhs-accounts.browser.test.mjs",
    "test:xhs-collect": "node --test scripts/xhs-collect.browser.test.mjs scripts/xhs-authorization.test.mjs",
    "lint": "eslint src browser-tests *.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.154",
    "@nuxt/ui": "^4.12.0",
    "idb": "8.0.4",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "qrcode": "1.5.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@0.27.7": "0.28.1",
      "source-map-js@<1.2.2": "1.2.2",
      "dompurify@<3.4.17": "3.4.17",
      "undici@<8.12.2": "8.12.3"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  },
  "packageManager": "pnpm@10.14.0"
}
