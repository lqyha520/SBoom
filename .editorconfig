# 编辑器基础约定（与 .gitattributes 的 LF 策略一致）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
# Markdown 行尾两个空格有语义，不自动裁剪
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
