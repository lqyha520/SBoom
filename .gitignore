# ============================
# 环境变量 & 敏感配置
# ============================
.env
.env.*
!**/.env*.example

# ============================
# Python 编译缓存
# ============================
__pycache__/
*.py[cod]
*.pyo

# ============================
# 虚拟环境
# ============================
venv/
env/
.venv/

# ============================
# IDE & 编辑器
# ============================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================
# 系统文件
# ============================
.DS_Store
Thumbs.db
desktop.ini

# ============================
# 日志 & 临时文件
# ============================
*.log
*.tmp
*.temp
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================
# 多用户数据（用户库 / 服务密钥，绝不入库）
# ============================
data/
!app/data/
app/data/*
!app/data/pep_catalog.json

# ============================
# 构建产物（只忽略三个前端子项目的产物，避免误吞其它目录里的 dist）
# ============================
/web/dist/
/admin/dist/
/miniprogram/dist/
build/
*.egg-info/

# ============================
# 前端（Vue）
# ============================
node_modules
miniprogram/src/project.private.config.json
miniprogram/project.private.config.json
# 账号删除备份含微信标识哈希与密码哈希，属用户数据，绝不入库
# 注：web/admin 的 pnpm-workspace.yaml 需要入库（含 pnpm v10+ 构建脚本白名单，
# 缺失时新 clone 的 esbuild postinstall 会被拒绝，vite 无法使用）

# 独立项目（不属于本仓库）
math-question-bank/

# ============================
# 本地工作文件（不入库）
# ============================
.workbuddy/
.ccgui/
# 工程审查工作区（临时分析产物 + 运行日志）
.review/
_*.py
_*.js
_*.txt
# 仓库根的一次性排查/改库脚本：正式脚本放 scripts/，临时脚本放 artifacts/（不入库）
/check_*.py
/update_*.py
/verify_*.py
/*.sql
# 本机运行的日志与 PID 文件
server.log*
server.pid
*.pid
# 截图/压测/回归产物（子目录白名单见上）
# 生产环境密钥
artifacts/
deploy/ops-status/
/deploy/docker-compose.override.yml
