# learn-coach 生产环境配置模板
# 用法：cp .env.production.example .env.production，填完再 docker compose --env-file .env.production up -d --build
# 注意：此文件含密钥，不要提交进 git。

# ─── 反向代理 ───
# 你的备案域名（Caddy 用它签 HTTPS 证书；小程序正式包的 VITE_API_BASE_URL 也是它）
DOMAIN=api.example.com

# ─── 数据库（compose 内部使用，改密码只需同步改这里） ───
POSTGRES_USER=learncoach
POSTGRES_PASSWORD=
POSTGRES_DB=learncoach

# ─── 服务 ───
DEBUG=false
WORKERS=2
FORCE_HTTPS=true

# 会话签名密钥：必须显式设置（可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成）
SECRET_KEY=

# 注册开关
REGISTRATION_ENABLED=true
MINI_REGISTRATION_ENABLED=true

# ─── 后台种子管理员（首次启动自动创建；之后可从 .env 移除） ───
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── LLM（兜底配置；后台「系统设置→模型配置」里配的优先） ───
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ─── 微信小程序 ───
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ─── 微信支付（不上线支付就保持 WECHAT_PAY_ENABLED=false） ───
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/data/wechat/apiclient_key.pem
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_KEY_PATH=/app/data/wechat/platform_pub_key.pem
WECHAT_PAY_API_V3_KEY=
# 支付回调地址（就是你的 HTTPS 域名）
WECHAT_PAY_NOTIFY_ORIGIN=https://api.example.com
