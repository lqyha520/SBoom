[Unit]
Description=Monthly isolated Learning Coach restore verification
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/learn-coach
EnvironmentFile=/etc/learn-coach/release.env
UMask=0077
ExecStartPre=/usr/bin/python3 scripts/release/ops.py check
ExecStart=/usr/bin/python3 scripts/release/ops.py restore-check
TimeoutStartSec=3600
