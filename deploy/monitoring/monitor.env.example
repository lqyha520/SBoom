# 仅检查和输出 JSON，不包含通知 webhook 或数据库凭据。
OPS_READY_URL=https://YOUR_DOMAIN/readyz
# 宿主需自行提供仅loopback可达的metrics代理，或在内部网络中运行检查。
OPS_METRICS_URL=http://127.0.0.1:9090/metrics
OPS_DISK_PATH=/var/lib/docker
# 与release.env中的OPS_STATUS_DIR一致，目录读权限授予监控用户。
OPS_BACKUP_STATUS=/var/lib/learn-coach/ops-status/backup.json
OPS_TLS_HOST=YOUR_DOMAIN
