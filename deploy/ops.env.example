# 复制到服务器仓库外的 /etc/learn-coach/ops.env，权限 600。
# R2 控制台创建独立私有 bucket 和仅可访问该 bucket 的 S3 凭据。
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/learn-coach-backup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
RESTIC_PASSWORD_FILE=/run/secrets/restic-password
# 仅备份容器使用；密码与生产数据库一致，主机为 compose 网络中的 db。
DATABASE_URL=postgresql://learncoach:REPLACE@db:5432/learncoach
# 建议使用 Healthchecks 等“每日成功心跳”监控；漏跑也会告警。
BACKUP_HEARTBEAT_URL=
# 独立月周期心跳，不能复用每日备份的地址。
RESTORE_HEARTBEAT_URL=
# 企业微信机器人的完整 webhook；本文件不入库。
BACKUP_ALERT_WEBHOOK=
# 飞书群自定义机器人的完整 webhook；与企业微信可任选一个，也可同时配置。
BACKUP_FEISHU_WEBHOOK=
# 飞书机器人开启“签名校验”时填写签名密钥，未开启则留空。
BACKUP_FEISHU_SECRET=
