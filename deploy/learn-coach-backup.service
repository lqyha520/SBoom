[Unit]
Description=Consistent Learning Coach backup
After=network-online.target
OnFailure=learn-coach-backup-alert.service

[Service]
Type=oneshot
WorkingDirectory=/opt/learn-coach
EnvironmentFile=/etc/learn-coach/release.env
UMask=0077
ExecStart=/usr/bin/python3 scripts/release/ops.py backup
TimeoutStartSec=1800
