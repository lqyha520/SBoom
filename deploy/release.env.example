COMPOSE_PROJECT_NAME=learncoach
RELEASE_ENV_FILE=/etc/learn-coach/release.env
SERVICE_ENV_FILE=/etc/learn-coach/service.env
OPS_ENV_FILE=/etc/learn-coach/ops.env
RESTIC_PASSWORD_PATH=/etc/learn-coach/restic-password
OPS_STATUS_DIR=/var/lib/learn-coach/ops-status
# Dedicated receipt-reading group; never reuse the app/secret group 10001.
OPS_STATUS_GID=10002
APP_IMAGE=learncoach-app:RELEASE
OPS_IMAGE=learncoach-ops:RELEASE
# 必须核实已有生产容器镜像发行版与 digest，禁止直接把现有 Alpine 卷换成 glibc。
POSTGRES_IMAGE=postgres:16-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
PROD_NETWORK=learncoach_default
PROD_PGDATA_VOLUME=REPLACE_WITH_EXISTING_VOLUME
PROD_APPDATA_VOLUME=REPLACE_WITH_EXISTING_VOLUME
FORWARDED_ALLOW_IPS=192.168.64.1
POSTGRES_USER=learncoach
POSTGRES_DB=learncoach
POSTGRES_PASSWORD=REPLACE
SECRET_KEY=REPLACE
