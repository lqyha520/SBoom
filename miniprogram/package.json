    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "htmlparser2": "10.0.0",
    "vue": "3.5.42",
    "vue-i18n": "9.14.5",
    "@wot-ui/ui": "2.3.2"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@iconify-json/lucide": "1.2.132",
    "@types/node": "^22.0.0",
    "miniprogram-api-typings": "5.2.3",
    "sass": "^1.98.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vite": "5.2.8",
    "vue-tsc": "3.3.11"
  }
