{
  "name": "learn-coach-miniprogram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:mp": "node scripts/check-build.mjs",
    "check:release": "node scripts/check-build.mjs --release",
    "assets": "node scripts/build-icons.mjs",
    "assets:editorial": "node scripts/build-editorial-assets.mjs",
    "lint": "eslint src scripts",
    "check:overrides": "node scripts/check-overrides.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@wot-ui/ui": "2.3.2",
    "vue": "3.5.43",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@eslint/js": "^9.39.5",
    "@iconify-json/lucide": "1.2.139",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.1",
    "miniprogram-api-typings": "5.2.3",
    "sass": "^1.105.1",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "6.4.3",
    "vue-tsc": "3.3.12"
  }
}
