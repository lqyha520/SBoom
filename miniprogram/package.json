{
  "name": "learn-coach-miniprogram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:mp": "node scripts/check-build.mjs",
    "check:release": "node scripts/check-build.mjs --release",
    "assets": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
