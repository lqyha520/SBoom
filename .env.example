# LLM 服务配置
# 支持 OpenAI 兼容接口，可接入 DeepSeek / 通义千问 / GPT 等

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# 生成参数
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_TOP_P=0.9

# 每轮默认生成题目数
DEFAULT_QUESTION_COUNT=5
MAX_QUESTION_COUNT=10

# 缓存
CACHE_ENABLED=true
CACHE_MAX_SIZE=500
CACHE_TTL_SECONDS=86400

# 服务
HOST=127.0.0.1
PORT=8000
