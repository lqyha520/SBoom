# LLM 服务配置（.env 兜底值：后台「模型配置」保存的配置优先生效）
# 支持 OpenAI 兼容接口，可接入 DeepSeek / 通义千问 / GPT 等
# 推荐做法：LLM_API_KEY 留空，由管理员登录 /admin 在「模型配置」中统一设置（密钥加密存库）

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_TOP_P=0.9

# 每轮默认生成题目数
DEFAULT_QUESTION_COUNT=5
MAX_QUESTION_COUNT=10

# 题目缓存（默认关闭：每次生成都真实调用 LLM，保证同参数出不同试卷）
# 若想省钱提速可改为 true：相同参数组合 24h 内复用同一份结果
CACHE_ENABLED=false
CACHE_MAX_SIZE=500
CACHE_TTL_SECONDS=86400

# 服务
HOST=127.0.0.1
PORT=8000

# 多用户
# 会话签名/加密密钥：留空则自动生成并持久化到 data/secret_key.txt
# 生产环境建议固定（重启/多实例需一致），可用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
SECRET_KEY=
# 跨域白名单（逗号分隔），留空 = 仅同源访问（默认，最安全）
# 示例：CORS_ORIGINS=https://exam.example.com
CORS_ORIGINS=

# 后台管理（可选）
# 种子管理员：设置后每次启动自动创建/对齐该管理员账号
# 注意：不设置时，数据库中第一个注册的用户自动成为管理员
ADMIN_USERNAME=
ADMIN_PASSWORD=
