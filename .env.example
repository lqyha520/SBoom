# LLM 服务配置（.env 兜底值：后台「模型配置」保存的配置优先生效）
# 支持 OpenAI 兼容接口，可接入 DeepSeek / 通义千问 / GPT 等
# 推荐做法：LLM_API_KEY 留空，由管理员登录 /admin 在「模型配置」中统一设置（密钥加密存库）

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=16384
LLM_TOP_P=0.9

# 每轮默认生成题目数
DEFAULT_QUESTION_COUNT=5
MAX_QUESTION_COUNT=30

# 生成保护：按用户滚动 24 小时计数，查询/重放原请求不重复扣额度；0 = 不限次数
GENERATION_DAILY_LIMIT=20
GENERATION_USER_CONCURRENCY=2
GENERATION_GLOBAL_CONCURRENCY=6
GENERATION_GLOBAL_DAILY_TOKENS=2000000
GENERATION_GLOBAL_DAILY_IMAGES=100
GENERATION_HEARTBEAT_SECONDS=90
# 每个生成请求最多追加的缺题修复调用次数（0 = 关闭；阅读题不自动补写其他文章）
GENERATION_REPAIR_LIMIT=3
# 请求最大生命周期与结果保留天数；过期后仍保留去重记录
GENERATION_LEASE_SECONDS=3600
GENERATION_RESULT_DAYS=7

# 服务
HOST=127.0.0.1
PORT=8000
# 热重载仅开发时开启（性能差且不安全）；生产必须 false
DEBUG=false
# worker 进程数（默认 1；>1 开多进程，多实例共享同一 PostgreSQL）
WORKERS=1
# 日志格式：auto = FORCE_HTTPS 时 JSON、否则文本；也可显式指定 json / text
LOG_FORMAT=auto
# 非上传接口的请求体上限（字节；按 Content-Length 在中间件层直接 413），上传接口有各自的限额
MAX_REQUEST_BODY_BYTES=4194304

# 数据库：PostgreSQL 连接串（必填，本服务仅支持 PG）
# 本地开发可用 Docker 一键起库：
#   docker run -d --name learncoach-db -p 127.0.0.1:5432:5432 \
#     -e POSTGRES_USER=learncoach -e POSTGRES_PASSWORD=learncoach -e POSTGRES_DB=learncoach postgres:16-bookworm
DATABASE_URL=postgresql://learncoach:learncoach@127.0.0.1:5432/learncoach
# 连接池（每个 worker 进程各一池）：DB_POOL_MAX 应 >= 预期并发请求数，线程池上限会按 2 倍放大；多 worker 时 WORKERS×DB_POOL_MAX 不能超过 PG 的 max_connections
DB_POOL_MIN=1
DB_POOL_MAX=10
# 池耗尽时最多等多少秒再报错
DB_POOL_TIMEOUT=30
# 服务端会话超时（毫秒，0 = 不限）：单条语句上限
DB_STATEMENT_TIMEOUT_MS=30000
# 等锁上限：也约束 db(serialized=...) 的事务级咨询锁排队，长时间串行任务多时可调大
DB_LOCK_TIMEOUT_MS=10000
# 事务内空闲上限：防止忘记提交的连接长期占着行锁
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# 出题工作台与小程序各自的注册开关；关闭后已有账号仍可登录
REGISTRATION_ENABLED=true
MINI_REGISTRATION_ENABLED=true

# 多用户
# 会话签名/加密密钥：留空则自动生成并持久化到 data/secret_key.txt
# 生产环境建议固定（重启/多实例需一致），可用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
SECRET_KEY=
# 跨域白名单（逗号分隔），留空 = 仅同源访问（默认，最安全）
# 示例：CORS_ORIGINS=https://exam.example.com
CORS_ORIGINS=
# HTTPS 部署时开启 Secure 会话 Cookie；本机 HTTP 开发保持 false
FORCE_HTTPS=false
# 反向代理的来源地址（uvicorn 读取，逗号分隔）：只信任这些地址发来的 X-Forwarded-For。
# 默认仅 127.0.0.1；Docker bridge 部署时代理源地址是网关 IP（如 172.18.0.1），不填则按 IP 的限流会把所有人算成同一个 IP。切勿填 *
# FORWARDED_ALLOW_IPS=172.18.0.1

# 试卷文件：私人归档与管理员发布的公共条目均通过鉴权 API 读取
# 默认使用本机私有目录，无需云存储账号即可开发
# 留空使用 data/paper-files；生产环境须持久化并与数据库一起备份
ARCHIVE_LOCAL_DIR=
ARCHIVE_MAX_PAPERS=1000
ARCHIVE_STORAGE_MB=512
ARCHIVE_MAX_BUNDLE_MB=40

# 微信登录：只能放在服务端；没有真实配置时不会开启模拟登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MINI_SESSION_DAYS=7

# 微信支付 API v3：套餐在后台配置，支付默认关闭；没有配置时不会模拟付款成功
# 私钥/平台公钥文件应位于服务端私有目录，不可放在静态资源目录或提交进 Git
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
# 仅 HTTPS 源地址（不含路径），回调路由由应用追加
WECHAT_PAY_NOTIFY_ORIGIN=
# 按实际商品类目、微信支付能力与平台准入启用；默认不向 iOS 提供在线开通
WECHAT_PAY_IOS_ENABLED=false
# 自动核对昨日账单（北京时间 10:00 后），需要先启用支付
WECHAT_PAY_AUTO_RECONCILE=false

# 微信订阅提醒：仅在用户主动接受一次订阅后发送，未配置时仅使用站内消息
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_TITLE_FIELD=
WECHAT_SUBSCRIBE_BODY_FIELD=
WECHAT_SUBSCRIBE_TIME_FIELD=

# 使用私有桶，仅允许本应用所需的读、写、删除对象权限

# 后台管理（首次部署需要配置，或使用已有管理员账号）
# 种子管理员：仅首次创建；显式 ADMIN_RESET_ON_START=true 才重置
# 注册始终创建普通用户，不会将首个注册者提升为管理员
ADMIN_USERNAME=
ADMIN_PASSWORD=

LOG_TO_FILE=false

# Monitoring is independent of HTTPS. Run python run.py for multi-worker aggregation.
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9090
# Bounded storage/event maintenance runs every minute, including without WeChat payments.
MAINTENANCE_ENABLED=true
IMAGE_STORAGE_MB=512
# Materialized when importing a document without known question types.
IMPORT_DEFAULT_VIEW_ACCESS=free
IMPORT_DEFAULT_DOWNLOAD_ACCESS=free

# P2/P3：生产迁移用 python -m app.migrations；密钥环轮换见 scripts/rotate_encryption.py。
ENCRYPTION_KEYS={}
ENCRYPTION_ACTIVE_KEY=
ADMIN_RESET_ON_START=false
API_DOCS_ENABLED=true
DB_AUTO_MIGRATE=true
SESSION_IDLE_SECONDS=86400
PROVIDER_ALLOW_PRIVATE=false
PROVIDER_MAX_RESPONSE_BYTES=8388608
